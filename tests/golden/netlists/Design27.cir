.SUBCKT BC264D 10 20 30
J1 10 20 30 NJF
.MODEL NJF NJF
+             VTO = -2.3085E+000
+            BETA = 1.09045E-003
+          LAMBDA = 2.31754E-002
+              RD = 7.77648E+000
+              RS = 7.77648E+000
+              IS = 2.59121E-016
+            CGS  = 2.00000E-012
+            CGD  = 2.20000E-012
+              PB = 9.91494E-001
+              FC = 5.00000E-001
.ENDS
Rshunt_1 1 0 1e12
Rshunt_3 3 0 1e12
Rshunt_2 2 0 1e12
